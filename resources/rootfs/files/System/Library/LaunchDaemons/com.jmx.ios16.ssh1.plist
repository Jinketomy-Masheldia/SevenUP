<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jmx.ios16.ssh1</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/ssh1/dropbear</string>
		<string>-F</string>
		<string>-E</string>
		<string>-m</string>
		<string>-p</string>
		<string>22</string>
		<string>-r</string>
		<string>/usr/local/etc/ssh1/dropbear_ecdsa_host_key</string>
		<string>-P</string>
		<string>/var/run/ssh1-dropbear.pid</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>root</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/private/var/log/ssh1-dropbear.log</string>
	<key>StandardErrorPath</key>
	<string>/private/var/log/ssh1-dropbear.log</string>
	<key>LimitLoadToSessionType</key>
	<string>System</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
</dict>
</plist>
